{
  "name": "@kts/public-web",
  "version": "1.0.0",
  "private": true,
  "description": "Key Tech Solutions public website (Next.js App Router, server rendered).",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "vercel-build": "pnpm --filter \"@kts/public-web^...\" build && next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@kts/api-client": "workspace:*",
    "@kts/config": "workspace:*",
    "@kts/seo": "workspace:*",
    "@kts/shared-types": "workspace:*",
    "@kts/ui": "workspace:*",
    "@kts/validation": "workspace:*",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.18",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
}
