{
  "name": "@kts/api",
  "version": "1.0.0",
  "private": true,
  "description": "Key Tech Solutions REST API (NestJS + Fastify + Prisma).",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "vercel-build": "pnpm --filter \"@kts/api^...\" build && prisma generate --schema ../../prisma/schema.prisma && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/multipart": "8.3.0",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "7.0.4",
    "@kts/config": "workspace:*",
    "@kts/email-templates": "workspace:*",
    "@kts/seo": "workspace:*",
    "@kts/shared-types": "workspace:*",
    "@kts/validation": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-fastify": "10.4.15",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "fastify": "4.28.1",
    "nodemailer": "6.9.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.14",
    "@types/node": "20.14.10",
    "@types/nodemailer": "6.4.16",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
