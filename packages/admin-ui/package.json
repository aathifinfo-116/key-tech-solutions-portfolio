{
  "name": "@kts/admin-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Key Tech Solutions admin design system: shell, tables, forms and feedback.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/admin.css": "./src/styles/admin.css"
  },
  "scripts": {
    "build": "echo \"@kts/admin-ui is consumed as source via Next transpilePackages\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kts/config": "workspace:*",
    "@kts/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  }
}
