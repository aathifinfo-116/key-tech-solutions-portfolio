# =============================================================================
# Key Tech Solutions - Portfolio Management Platform
# Copy this file to .env and fill in the values locally.
# NEVER commit a populated .env file. NEVER put secrets in NEXT_PUBLIC_* vars.
# =============================================================================

# ----------------------------- Runtime --------------------------------------
NODE_ENV=development

# ----------------------------- Database --------------------------------------
# Set DATABASE_PASSWORD to a strong, newly generated password.
# Then compose DATABASE_URL / DATABASE_DIRECT_URL from the parts below.
DATABASE_NAME=key-tech-solutions-portfolio-management
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Example shape (fill in yourself, URL-encode special characters in the password):
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=
# Direct (non-pooled) connection used by prisma migrate / introspection.
DATABASE_DIRECT_URL=

# --------------------------- API (NestJS) ------------------------------------
API_PORT=4010
API_HOST=0.0.0.0
# Public origin the API is reachable at (used for absolute URLs it returns).
API_PUBLIC_URL=http://localhost:4010

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3010,http://localhost:3011

# Session cookie signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=kts_admin_session
# Session lifetime in minutes (idle + absolute cap).
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
# Set to true only when API and admin are served over HTTPS.
SESSION_COOKIE_SECURE=false
# Cookie domain shared by admin + api (leave empty for host-only cookies).
SESSION_COOKIE_DOMAIN=

# bcrypt work factor (10-14; higher is slower and safer)
PASSWORD_HASH_ROUNDS=12
# Failed login attempts before the account is temporarily locked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Shared secret used by the web apps to call on-demand revalidation + preview.
REVALIDATE_SECRET=
PREVIEW_SECRET=

# ------------------------- Rate limiting --------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
PUBLIC_FORM_RATE_LIMIT_MAX=5
# Comma separated IPs exempt from the global ceiling (not from the form limit).
# Defaults to loopback so a static site build is never throttled.
RATE_LIMIT_ALLOWLIST=

# ----------------------------- Storage ----------------------------------------
# local | s3   (s3 provider is scaffolded but not enabled by default)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
# Origin that serves public media (the API serves /api/v1/media/file/* by default).
STORAGE_PUBLIC_BASE_URL=http://localhost:4010/api/v1/media/file
MAX_UPLOAD_IMAGE_MB=8
MAX_UPLOAD_DOCUMENT_MB=15

# Reserved for a future S3-compatible bucket. Leave empty for local development.
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------ Email -----------------------------------------
# log | smtp  ("log" writes rendered emails to the API log, no delivery)
MAIL_DRIVER=log
MAIL_FROM="Key Tech Solutions <no-reply@example.invalid>"
MAIL_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ------------------------ Seed bootstrap account -------------------------------
# The seed creates the first Super Administrator with these values.
# Use a throwaway local password; rotate immediately in any shared environment.
SEED_ADMIN_EMAIL=admin@keytech.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Key Tech Administrator

# ------------------------- Public website (Next.js) ----------------------------
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_SITE_NAME=Key Tech Solutions
NEXT_PUBLIC_API_URL=http://localhost:4010
# Server-side API base used during SSR/SSG (can point at an internal hostname).
API_INTERNAL_URL=http://localhost:4010
# Search console / analytics (optional, public by nature)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ID=

# --------------------------- Admin website -------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3011
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4010
ADMIN_INTERNAL_API_URL=http://localhost:4010
