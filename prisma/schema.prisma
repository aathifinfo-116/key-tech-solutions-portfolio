model JobApplication {
  id            String            @id @default(uuid()) @db.Uuid
  careerId      String            @db.Uuid
  applicantName String
  email         String
  mobile        String?
  portfolioUrl  String?
  linkedinUrl   String?
  coverNote     String?
  cvDocumentId  String?           @db.Uuid
  consentGiven  Boolean           @default(false)
  consentText   String?
  appliedAt     DateTime          @default(now())
  applicationStatus ApplicationStatus @default(RECEIVED)
  internalNotes String?
  sourceIp      String?
  userAgent     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  archivedAt    DateTime?

  career Career         @relation(fields: [careerId], references: [id], onDelete: Cascade)
  cv     DocumentAsset? @relation("ApplicationCv", fields: [cvDocumentId], references: [id], onDelete: SetNull)

  @@index([careerId, applicationStatus])
  @@index([appliedAt])
  @@map("job_applications")
}

// -----------------------------------------------------------------------------
// Leads, contact and quote requests
// -----------------------------------------------------------------------------

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  reference      String     @unique
  type           LeadType   @default(CONTACT)
  leadStatus     LeadStatus @default(NEW)
  name           String
  email          String
  mobile         String?
  organization   String?
  subject        String?
  message        String?
  serviceInterest String?
  assignedToId   String?    @db.Uuid
  attachmentId   String?    @db.Uuid
  consentGiven   Boolean    @default(false)
  consentText    String?
  sourcePage     String?
  sourceIp       String?
  userAgent      String?
  spamScore      Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  archivedAt     DateTime?

  assignedTo AdminUser?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  attachment DocumentAsset? @relation("LeadAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  notes        LeadNote[]
  contact      ContactSubmission?
  quoteRequest QuoteRequest?

  @@index([leadStatus, createdAt])
  @@index([type])
  @@index([assignedToId])
  @@index([email])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  channel   String?
  isInternal Boolean @default(true)
  createdAt DateTime @default(now())

  lead   Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model ContactSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  leadId          String   @unique @db.Uuid
  serviceInterest String?
  subject         String
  message         String
  createdAt       DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("contact_submissions")
}

model QuoteRequest {
  id                String   @id @default(uuid()) @db.Uuid
  leadId            String   @unique @db.Uuid
  projectType       String
  businessChallenge String
  requiredFeatures  String[] @default([])
  existingSystem    String?
  budgetRange       String?
  preferredStart    String?
  timelineNote      String?
  createdAt         DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("quote_requests")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String?
  isConfirmed    Boolean   @default(false)
  confirmTokenHash String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  sourcePage     String?
  sourceIp       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isConfirmed])
  @@map("newsletter_subscribers")
}
