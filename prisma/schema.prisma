// =============================================================================
// Key Tech Solutions - Portfolio Management Platform
// Prisma schema. Every credential is supplied through environment variables.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum PublicationStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ContentEntityType {
  PAGE
  PAGE_SECTION
  SERVICE
  SERVICE_CATEGORY
  SOLUTION
  INDUSTRY
  PRODUCT
  PORTFOLIO_PROJECT
  CASE_STUDY
  BLOG_POST
  BLOG_CATEGORY
  CAREER
  TEAM_MEMBER
  TESTIMONIAL
  CLIENT
  PARTNER
  PROCESS_PHASE
  TECHNOLOGY
  COMPANY_VALUE
  COMPANY_MILESTONE
  STATISTIC
  NAVIGATION_MENU
  FOOTER_GROUP
  ANNOUNCEMENT
  SITE_SETTING
  BRAND_SETTING
  REDIRECT_RULE
  MEDIA_ASSET
  DOCUMENT_ASSET
  LEAD
  JOB_APPLICATION
  NEWSLETTER_SUBSCRIBER
  ADMIN_USER
  ROLE
}

enum SectionTheme {
  LIGHT
  WHITE
  SOFT_PURPLE
  SOFT_TEAL
  DARK
  BRAND_GRADIENT
}

enum SectionType {
  HERO
  RICH_TEXT
  SPLIT_CONTENT
  IMAGE_GALLERY
  STATISTICS
  SERVICE_GRID
  PRODUCT_GRID
  SOLUTION_GRID
  PORTFOLIO_GRID
  CASE_STUDY
  PROCESS_STEPS
  TIMELINE
  VALUES
  TEAM
  TESTIMONIALS
  LOGO_CLOUD
  FAQ
  DOWNLOAD
  CTA
  CONTACT_BLOCK
  TECHNOLOGY_GRID
  VIDEO
  QUOTE
  CAPABILITY_STRIP
  INDUSTRY_GRID
  BLOG_PREVIEW
}

enum ContentBlockType {
  PARAGRAPH
  HEADING
  IMAGE
  GALLERY
  QUOTE
  CALLOUT
  CODE
  LIST
  TABLE
  VIDEO_EMBED
  DOWNLOAD
  CTA
  RELATED_CONTENT
}

enum ProductStatus {
  CONCEPT
  PLANNED
  IN_DEVELOPMENT
  COMING_SOON
  BETA
  LIVE
  MAINTENANCE
  RETIRED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ONGOING
  COMPLETED
  MAINTENANCE
  PRIVATE
}

enum BlogPostType {
  ARTICLE
  TECHNICAL_GUIDE
  PRODUCT_UPDATE
  RELEASE_NOTE
  CASE_STUDY
  COMPANY_NEWS
  INDUSTRY_INSIGHT
}

enum CareerStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum ApplicationStatus {
  RECEIVED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum LeadType {
  CONTACT
  QUOTE
  NEWSLETTER
  CAREER
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  SPAM
  ARCHIVED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaKind {
  IMAGE
  LOGO
  ICON
  SCREENSHOT
  OPEN_GRAPH
}

enum DocumentKind {
  LEAD_ATTACHMENT
  CV
  BROCHURE
  CASE_STUDY_DOWNLOAD
  GENERAL
}

enum RedirectStatus {
  PERMANENT_301
  FOUND_302
  TEMPORARY_307
  PERMANENT_308
  GONE_410
}

enum SitemapFrequency {
  ALWAYS
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NEVER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  PUBLISH
  UNPUBLISH
  SCHEDULE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  PASSWORD_CHANGE
  PERMISSION_CHANGE
  UPLOAD
  DOWNLOAD
  EXPORT
  STATUS_CHANGE
}

enum NavigationLocation {
  PRIMARY
  FOOTER
  UTILITY
  MOBILE
  LEGAL
}

enum AnnouncementTone {
  INFO
  BRAND
  SUCCESS
  WARNING
}

enum RevisionAction {
  SAVED
  SUBMITTED_FOR_REVIEW
  PUBLISHED
  UNPUBLISHED
  SCHEDULED
  ARCHIVED
  RESTORED
  DUPLICATED
}

// -----------------------------------------------------------------------------
// Identity, access control and auditing
// -----------------------------------------------------------------------------

model AdminUser {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique
  name               String
  jobTitle           String?
  passwordHash       String
  status             AdminUserStatus @default(INVITED)
  mustChangePassword Boolean         @default(false)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  avatarUrl          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  archivedAt         DateTime?

  roles             UserRole[]
  sessions          AdminSession[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]
  revisions         PageRevision[]
  uploadedMedia     MediaAsset[]    @relation("MediaUploader")
  uploadedDocuments DocumentAsset[] @relation("DocumentUploader")
  assignedLeads     Lead[]          @relation("LeadAssignee")
  leadNotes         LeadNote[]
  createdRedirects  RedirectRule[]  @relation("RedirectAuthor")
  authorProfile     Author?

  @@index([status])
  @@index([archivedAt])
  @@map("admin_users")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
  @@map("admin_sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  family      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([family])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  actorId     String?           @db.Uuid
  actorEmail  String?
  action      AuditAction
  entityType  ContentEntityType
  entityId    String?
  entityLabel String?
  summary     String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime          @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  scope        String
  requestHash  String
  responseBody Json?
  statusCode   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}

// -----------------------------------------------------------------------------
// Media, documents and SEO primitives
// -----------------------------------------------------------------------------

model MediaAsset {
  id           String          @id @default(uuid()) @db.Uuid
  storageKey   String          @unique
  originalName String
  generatedName String
  mimeType     String
  extension    String
  kind         MediaKind       @default(IMAGE)
  visibility   MediaVisibility @default(PUBLIC)
  folder       String          @default("content")
  sizeBytes    Int
  width        Int?
  height       Int?
  aspectRatio  Float?
  blurDataUrl  String?
  altText      String?
  caption      String?
  focalX       Float           @default(0.5)
  focalY       Float           @default(0.5)
  checksum     String?
  variants     Json?
  uploadedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  archivedAt   DateTime?

  uploadedBy AdminUser? @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  usages             MediaUsage[]        @relation("MediaUsageAsset")
  seoOgImages        SeoMetadata[]       @relation("SeoOgImage")
  pageCovers         Page[]              @relation("PageCover")
  sectionMedia       PageSection[]       @relation("SectionMedia")
  blockMedia         ContentBlock[]      @relation("ContentBlockMedia")
  serviceCovers      Service[]           @relation("ServiceCover")
  solutionCovers     Solution[]          @relation("SolutionCover")
  industryCovers     Industry[]          @relation("IndustryCover")
  productLogos       Product[]           @relation("ProductLogo")
  productCovers      Product[]           @relation("ProductCover")
  productScreenshots ProductScreenshot[] @relation("ProductScreenshotMedia")
  portfolioCovers    PortfolioProject[]  @relation("PortfolioCover")
  caseStudyCovers    CaseStudy[]         @relation("CaseStudyCover")
  blogCovers         BlogPost[]          @relation("BlogCover")
  authorAvatars      Author[]            @relation("AuthorAvatar")
  teamPhotos         TeamMember[]        @relation("TeamPhoto")
  testimonialPhotos  Testimonial[]       @relation("TestimonialPhoto")
  clientLogos        Client[]            @relation("ClientLogo")
  partnerLogos       Partner[]           @relation("PartnerLogo")
  technologyLogos    Technology[]        @relation("TechnologyLogo")
  processImages      ProcessPhase[]      @relation("ProcessImage")
  milestoneImages    CompanyMilestone[]  @relation("MilestoneImage")
  brandLogoLight     BrandSetting[]      @relation("BrandLogoLight")
  brandLogoDark      BrandSetting[]      @relation("BrandLogoDark")
  brandLogoMark      BrandSetting[]      @relation("BrandLogoMark")
  brandFavicon       BrandSetting[]      @relation("BrandFavicon")
  brandOgDefault     BrandSetting[]      @relation("BrandOgDefault")

  @@index([visibility, archivedAt])
  @@index([kind])
  @@index([folder])
  @@index([createdAt])
  @@map("media_assets")
}

model DocumentAsset {
  id           String          @id @default(uuid()) @db.Uuid
  storageKey   String          @unique
  originalName String
  generatedName String
  mimeType     String
  extension    String
  kind         DocumentKind    @default(GENERAL)
  visibility   MediaVisibility @default(PRIVATE)
  folder       String          @default("documents")
  sizeBytes    Int
  title        String?
  description  String?
  checksum     String?
  uploadedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  archivedAt   DateTime?

  uploadedBy AdminUser? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  leads        Lead[]           @relation("LeadAttachment")
  applications JobApplication[] @relation("ApplicationCv")
  caseStudies  CaseStudyDownload[]
  solutionDocs SolutionDocument[]

  @@index([visibility, archivedAt])
  @@index([kind])
  @@map("document_assets")
}

model MediaUsage {
  id         String            @id @default(uuid()) @db.Uuid
  mediaId    String            @db.Uuid
  entityType ContentEntityType
  entityId   String            @db.Uuid
  role       String            @default("gallery")
  sortOrder  Int               @default(0)
  altOverride String?
  createdAt  DateTime          @default(now())

  media MediaAsset @relation("MediaUsageAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, entityType, entityId, role])
  @@index([entityType, entityId, role, sortOrder])
  @@map("media_usages")
}

model SeoMetadata {
  id               String            @id @default(uuid()) @db.Uuid
  title            String?
  description      String?
  canonicalUrl     String?
  ogTitle          String?
  ogDescription    String?
  ogImageId        String?           @db.Uuid
  twitterCard      String            @default("summary_large_image")
  keywords         String[]          @default([])
  robotsIndex      Boolean           @default(true)
  robotsFollow     Boolean           @default(true)
  includeInSitemap Boolean           @default(true)
  sitemapPriority  Float             @default(0.5)
  sitemapFrequency SitemapFrequency  @default(WEEKLY)
  structuredDataOverride Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  ogImage MediaAsset? @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  page       Page?
  service    Service?
  solution   Solution?
  industry   Industry?
  product    Product?
  portfolio  PortfolioProject?
  caseStudy  CaseStudy?
  blogPost   BlogPost?
  blogCategory BlogCategory?
  career     Career?

  @@map("seo_metadata")
}

model RedirectRule {
  id          String         @id @default(uuid()) @db.Uuid
  source      String         @unique
  destination String
  status      RedirectStatus @default(PERMANENT_301)
  reason      String?
  isActive    Boolean        @default(true)
  hitCount    Int            @default(0)
  lastHitAt   DateTime?
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy AdminUser? @relation("RedirectAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("redirect_rules")
}

model PageRevision {
  id             String            @id @default(uuid()) @db.Uuid
  entityType     ContentEntityType
  entityId       String            @db.Uuid
  version        Int
  editorId       String?           @db.Uuid
  changeSummary  String?
  action         RevisionAction    @default(SAVED)
  statusAfter    PublicationStatus
  snapshot       Json
  createdAt      DateTime          @default(now())

  editor AdminUser? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("page_revisions")
}

// -----------------------------------------------------------------------------
// Global site configuration
// -----------------------------------------------------------------------------

model SiteSetting {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  value          Json
  group          String   @default("general")
  label          String
  description    String?
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

model BrandSetting {
  id             String   @id @default(uuid()) @db.Uuid
  singleton      Boolean  @default(true) @unique
  companyName    String   @default("Key Tech Solutions")
  shortName      String   @default("Key Tech")
  legalName      String?
  tagline        String?
  description    String?
  primaryColor   String   @default("#6436A3")
  secondaryColor String   @default("#416F9E")
  accentColor    String   @default("#2CA3A3")
  highlightColor String   @default("#5BC3C6")
  inkColor       String   @default("#111426")
  gradientCss    String   @default("linear-gradient(135deg, #6436A3 0%, #416F9E 50%, #2CA3A3 100%)")
  contactEmail   String?
  contactPhone   String?
  supportEmail   String?
  logoLightId    String?  @db.Uuid
  logoDarkId     String?  @db.Uuid
  logoMarkId     String?  @db.Uuid
  faviconId      String?  @db.Uuid
  ogDefaultId    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logoLight MediaAsset? @relation("BrandLogoLight", fields: [logoLightId], references: [id], onDelete: SetNull)
  logoDark  MediaAsset? @relation("BrandLogoDark", fields: [logoDarkId], references: [id], onDelete: SetNull)
  logoMark  MediaAsset? @relation("BrandLogoMark", fields: [logoMarkId], references: [id], onDelete: SetNull)
  favicon   MediaAsset? @relation("BrandFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  ogDefault MediaAsset? @relation("BrandOgDefault", fields: [ogDefaultId], references: [id], onDelete: SetNull)

  @@map("brand_settings")
}

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  platform  String   @unique
  label     String
  url       String
  iconName  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

model NavigationMenu {
  id        String             @id @default(uuid()) @db.Uuid
  key       String             @unique
  name      String
  location  NavigationLocation @default(PRIMARY)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  items NavigationItem[]

  @@map("navigation_menus")
}

model NavigationItem {
  id          String   @id @default(uuid()) @db.Uuid
  menuId      String   @db.Uuid
  parentId    String?  @db.Uuid
  label       String
  href        String
  description String?
  iconName    String?
  isExternal  Boolean  @default(false)
  openInNewTab Boolean @default(false)
  highlight   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemChildren")

  @@index([menuId, sortOrder])
  @@index([parentId])
  @@map("navigation_items")
}

model FooterGroup {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  title     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links FooterLink[]

  @@map("footer_groups")
}

model FooterLink {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  label      String
  href       String
  isExternal Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group FooterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("footer_links")
}

model Announcement {
  id        String           @id @default(uuid()) @db.Uuid
  message   String
  linkLabel String?
  linkHref  String?
  tone      AnnouncementTone @default(BRAND)
  isActive  Boolean          @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("announcements")
}

// -----------------------------------------------------------------------------
// Pages and the section based page builder
// -----------------------------------------------------------------------------

model Page {
  id            String            @id @default(uuid()) @db.Uuid
  slug          String            @unique
  path          String            @unique
  title         String
  eyebrow       String?
  headline      String?
  subheadline   String?
  summary       String?
  isSystem      Boolean           @default(false)
  showInSitemap Boolean           @default(true)
  status        PublicationStatus @default(DRAFT)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  coverImageId  String?           @db.Uuid
  seoId         String?           @unique @db.Uuid
  version       Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  archivedAt    DateTime?

  coverImage MediaAsset?  @relation("PageCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  seo        SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  sections   PageSection[]

  @@index([status, publishedAt])
  @@index([archivedAt])
  @@map("pages")
}

model PageSection {
  id           String            @id @default(uuid()) @db.Uuid
  pageId       String            @db.Uuid
  internalName String
  type         SectionType
  eyebrow      String?
  heading      String?
  subheading   String?
  description  String?
  bodyHtml     String?
  theme        SectionTheme      @default(WHITE)
  layoutVariant String           @default("default")
  backgroundImageUrl String?
  mediaId      String?           @db.Uuid
  primaryCtaLabel String?
  primaryCtaHref  String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  settings     Json?
  relatedIds   String[]          @default([])
  sortOrder    Int               @default(0)
  isVisible    Boolean           @default(true)
  visibleFrom  DateTime?
  visibleUntil DateTime?
  status       PublicationStatus @default(PUBLISHED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  page   Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media  MediaAsset?    @relation("SectionMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  blocks ContentBlock[]

  @@index([pageId, sortOrder])
  @@index([type])
  @@map("page_sections")
}

model ContentBlock {
  id         String           @id @default(uuid()) @db.Uuid
  sectionId  String?          @db.Uuid
  blogPostId String?          @db.Uuid
  type       ContentBlockType
  heading    String?
  text       String?
  html       String?
  code       String?
  language   String?
  items      Json?
  mediaId    String?          @db.Uuid
  href       String?
  linkLabel  String?
  settings   Json?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  section  PageSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  blogPost BlogPost?    @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  media    MediaAsset?  @relation("ContentBlockMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([sectionId, sortOrder])
  @@index([blogPostId, sortOrder])
  @@map("content_blocks")
}

// -----------------------------------------------------------------------------
// Offerings: services, solutions, industries, products
// -----------------------------------------------------------------------------

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  iconName    String?
  accentColor String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id              String            @id @default(uuid()) @db.Uuid
  slug            String            @unique
  name            String
  categoryId      String?           @db.Uuid
  shortDescription String
  fullDescription String?
  iconName        String?
  coverImageId    String?           @db.Uuid
  benefits        String[]          @default([])
  capabilities    String[]          @default([])
  deliverables    String[]          @default([])
  processSummary  String?
  ctaHeading      String?
  ctaDescription  String?
  ctaLabel        String?
  ctaHref         String?
  isFeatured      Boolean           @default(false)
  sortOrder       Int               @default(0)
  status          PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
